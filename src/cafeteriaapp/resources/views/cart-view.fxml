<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="590.0" prefWidth="835.0"
    xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="cafeteriaapp.resources.controllers.CartController">
   <top>
      <VBox style="-fx-background-color: #1a1a2e;" BorderPane.alignment="CENTER">
         <padding><Insets top="14.0" left="20.0" right="20.0" bottom="14.0"/></padding>
         <Label text="My Cart" textFill="WHITE">
            <font><Font size="22.0"/></font>
         </Label>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <BorderPane.margin><Insets top="10" left="20" right="20" bottom="10"/></BorderPane.margin>
         <content>
            <VBox fx:id="cartItemsContainer" spacing="10">
               <Label fx:id="emptyLabel" text="Your cart is empty. Add items from the Menu!"
                  style="-fx-text-fill: #888; -fx-font-size: 14px;" visible="true"/>
               <padding><Insets top="10" bottom="10"/></padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <VBox style="-fx-background-color: #f8f9fa; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0;"
         BorderPane.alignment="CENTER">
         <padding><Insets top="14" left="20" right="20" bottom="14"/></padding>
         <HBox alignment="CENTER_LEFT" spacing="20">
            <Label fx:id="totalLabel" text="Total: ₦0.00"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="checkoutBtn" text="Place Order" onAction="#handleCheckout"
               disable="true" styleClass="primary-btn"
               style="-fx-min-width: 160; -fx-font-size: 14px;"/>
         </HBox>
      </VBox>
   </bottom>
</BorderPane>
